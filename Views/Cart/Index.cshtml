@model IEnumerable<_25DH110574_Tien_KTRABE.Models.Product>

@{
    ViewBag.Title = "Giỏ hàng";

    var cart = ViewBag.Cart as Dictionary<int, int>;
    decimal total = 0;
}

<div class="container mt-4">

    <h2 class="mb-4">Giỏ hàng</h2>

    @if (TempData["CartMessage"] != null)
    {
        <div class="alert alert-warning">
            @TempData["CartMessage"]
        </div>
    }

    @if (Model != null && Model.Any())
    {
        foreach (var product in Model)
        {
            int quantity = cart.ContainsKey(product.ProductID)
                ? cart[product.ProductID]
                : 0;

            decimal subtotal = product.ProductPrice * quantity;
            total += subtotal;

            <div class="card mb-3">
                <div class="card-body">

                    <div class="row align-items-center">

                        <!-- Ảnh -->
                        <div class="col-md-2">
                            @if (!string.IsNullOrEmpty(product.ProductImage))
                            {
                                <img src="@Url.Content(product.ProductImage)"
                                     style="width:100px;height:100px;object-fit:cover;" />
                            }
                            else
                            {
                                <div style="width:100px;height:100px;background:#eee;
                                            display:flex;align-items:center;
                                            justify-content:center;">
                                    Không có ảnh
                                </div>
                            }
                        </div>

                        <!-- Thông tin -->
                        <div class="col-md-3">
                            <h5>@product.ProductName</h5>

                            <p class="mb-1">
                                Đơn giá:
                                <strong>@product.ProductPrice.ToString("N0") VNĐ</strong>
                            </p>

                            <p class="mb-0">
                                Tồn kho:
                                @product.Quantity
                            </p>
                        </div>

                        <!-- Số lượng -->
                        <div class="col-md-3 text-center">

                            <a href="@Url.Action("Decrease", "Cart",
                                new { id = product.ProductID })"
                               class="btn btn-outline-secondary">
                                −
                            </a>

                            <span class="mx-3">
                                <strong>@quantity</strong>
                            </span>

                            <a href="@Url.Action("Increase", "Cart",
                                new { id = product.ProductID })"
                               class="btn btn-outline-secondary">
                                +
                            </a>

                        </div>

                        <!-- Thành tiền -->
                        <div class="col-md-2">
                            <strong>
                                @subtotal.ToString("N0") VNĐ
                            </strong>
                        </div>

                        <!-- Xóa -->
                        <div class="col-md-2 text-end">
                            <a href="@Url.Action("Remove", "Cart",
                                new { id = product.ProductID })"
                               class="btn btn-danger">
                                Xóa
                            </a>
                        </div>

                    </div>

                </div>
            </div>
        }

        <!-- Tổng tiền -->
        <div class="text-end mt-4">
            <h4>
                Tổng tiền:
                <strong>@total.ToString("N0") VNĐ</strong>
            </h4>
        </div>

        <!-- Nút -->
        <div class="d-flex justify-content-between mt-4">

            <a href="@Url.Action("ContinueShopping", "Cart")"
               class="btn btn-outline-primary">
                Tiếp tục mua hàng
            </a>

            <a href="@Url.Action("Checkout", "Cart")"
               class="btn btn-primary">
                Thanh toán
            </a>

        </div>
    }
    else
    {
        <div class="text-center mt-5">
            <h5>Giỏ hàng đang trống</h5>

            <a href="@Url.Action("ContinueShopping", "Cart")"
               class="btn btn-primary mt-3">
                Tiếp tục mua hàng
            </a>
        </div>
    }

</div>