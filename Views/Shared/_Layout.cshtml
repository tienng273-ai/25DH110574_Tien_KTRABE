<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>@ViewBag.Title - MyStore</title>

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>

<body>

    <nav class="navbar navbar-expand-sm navbar-dark bg-dark">

        <div class="container">

            <!-- Logo -->
            @Html.ActionLink(
                     "MyStore ",
                     "Index",
                     "Home",
                     new { area = "" },
                     new { @class = "navbar-brand" }
                 )

            <button type="button"
                    class="navbar-toggler"
                    data-bs-toggle="collapse"
                    data-bs-target=".navbar-collapse">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse">

                <!-- Menu bên trái -->
                <ul class="navbar-nav flex-grow-1">

                    <li class="nav-item">
                        @Html.ActionLink(
                                 "Trang chủ",
                                 "Index",
                                 "Home",
                                 new { area = "" },
                                 new { @class = "nav-link" }
                             )
                    </li>

                    <li class="nav-item">
                        @Html.ActionLink(
                                 "Đơn hàng của tôi",
                                 "MyOrder",
                                 "Customer",
                                 new { },
                                 new { @class = "nav-link" }
                             )
                    </li>

                    <li class="nav-item">
                        @Html.ActionLink(
                                 "Giỏ hàng",
                                 "Index",
                                 "Cart",
                                 new { },
                                 new { @class = "nav-link" }
                             )
                    </li>

                </ul>

                <!-- Menu tài khoản -->
                <ul class="navbar-nav">

                    @if (Session["Username"] == null)
                    {
                        <li class="nav-item">
                            @Html.ActionLink(
                                     "Đăng nhập",
                                     "Login",
                                     "Account",
                                     new { },
                                     new { @class = "nav-link" }
                                 )
                        </li>

                        <li class="nav-item">
                            @Html.ActionLink(
                                     "Đăng ký",
                                     "Register",
                                     "Account",
                                     new { },
                                     new { @class = "nav-link" }
                                 )
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            @Html.ActionLink(
                                     "Tài khoản",
                                     "Edit",
                                     "Account",
                                     new { },
                                     new { @class = "nav-link" }
                                 )
                        </li>

                        <li class="nav-item">
                            <span class="nav-link text-light">
                                Xin chào, @Session["CustomerName"]
                            </span>
                        </li>

                        <li class="nav-item">
                            @Html.ActionLink(
                                     "Đăng xuất",
                                     "Logout",
                                     "Account",
                                     new { },
                                     new { @class = "nav-link" }
                                 )
                        </li>
                    }

                </ul>

            </div>

        </div>

    </nav>

    <!-- Nội dung trang -->
    <div class="container body-content">

        @RenderBody()

        <hr />

        <footer>
            <p>
                &copy; @DateTime.Now.Year - MyStore
            </p>
        </footer>

    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")

    @RenderSection("scripts", required: false)

</body>
@{
    var cart = Session["Cart"] as Dictionary<int, int>;
    int cartCount = cart != null ? cart.Values.Sum() : 0;
}

</html>