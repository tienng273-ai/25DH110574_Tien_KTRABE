<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>@ViewBag.Title - MyStore Admin</title>

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>

<body>

    <nav class="navbar navbar-expand-sm navbar-dark bg-dark">

        <div class="container">

            @Html.ActionLink(
                     "MyStore Admin",
                     "Index",
                     "Admin",
                     new { area = "" },
                     new { @class = "navbar-brand" }
                 )

            <button type="button"
                    class="navbar-toggler"
                    data-bs-toggle="collapse"
                    data-bs-target=".navbar-collapse">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse">

                <ul class="navbar-nav flex-grow-1">

                    <li class="nav-item">
                        @Html.ActionLink(
                                                          "Trang chủ Admin",
                                                          "Index",
                                                          "Admin",
                                                          new { },
                                                          new { @class = "nav-link" }
                                                      )
                    </li>

                    <li class="nav-item">
                        @Html.ActionLink(
                                                          "Quản lý đơn hàng",
                                                          "Index",
                                                          "Orders",
                                                          new { },
                                                          new { @class = "nav-link" }
                                                      )
                    </li>

                    <li class="nav-item" style="position: relative;">
                        <a href="javascript:void(0);"
                           class="nav-link"
                           onclick="toggleCategoryMenu()">
                            Quản lý danh mục ▾
                        </a>

                        <ul id="categoryMenu"
                            style="display:none;
                                   position:absolute;
                                   top:100%;
                                   left:0;
                                   background:white;
                                   min-width:180px;
                                   padding:8px 0;
                                   margin:0;
                                   list-style:none;
                                   border:1px solid #ddd;
                                   z-index:9999;">

                            <li>
                                @Html.ActionLink(
                                    "Danh mục",
                                    "Index",
                                    "Category",
                                    new { },
                                    new
                                         {
                                        @class = "dropdown-item",
                                        style = "display:block; padding:8px 15px; color:#333;"
                                    }
                                )
                            </li>

                        </ul>
                    </li>

                    <li>
                        @Html.ActionLink(
                                          "Quản lý sản phẩm",
                                          "Index",
                                          "Product",
                                          new { area = "" },
                                          null
                                      )
                    </li>

                    <li>
                        @Html.ActionLink(
                                     "Quản lý khách hàng",
                                     "Index",
                                     "Customer",
                                     new { area = "" },
                                     null
                                 )
                    </li>

                    <li>
                        @Html.ActionLink(
                                "Quản lý tài khoản",
                                "Index",
                                "User",
                                new { area = "" },
                                null
                            )
                    </li>

                    <li>
                        @Html.ActionLink(
                                          "Quản lý tồn kho",
                                          "Inventory",
                                          "Product",
                                          new { area = "" },
                                          null
                                      )
                    </li>

                </ul>

                <ul class="navbar-nav">

                    <li class="nav-item">
                        <span class="nav-link text-light">
                            Xin chào, Admin
                        </span>
                    </li>

                    <li class="nav-item">
                        @Html.ActionLink(
                                 "Đăng xuất",
                                 "Logout",
                                 "Account",
                                 new { },
                                 new { @class = "nav-link" }
                             )
                    </li>

                </ul>



            </div>

        </div>

    </nav>

    <div class="container body-content">

        @RenderBody()

        <hr />

        <footer>
            <p>
                &copy; @DateTime.Now.Year - MyStore Admin
            </p>
        </footer>

    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")


    <script>
        function toggleCategoryMenu() {
            var menu = document.getElementById("categoryMenu");

            if (menu.style.display === "none") {
                menu.style.display = "block";
            } else {
                menu.style.display = "none";
            }
        }
    </script>

    @RenderSection("scripts", required: false)

</body>
</html>