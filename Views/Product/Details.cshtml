@model _25DH110574_Tien_KTRABE.Models.Product

@{
    ViewBag.Title = "Chi tiết sản phẩm";
}

<div class="container mt-4">

    <h2>CHI TIẾT SẢN PHẨM</h2>

    <div class="row mt-4">

        <div class="col-md-4 text-center">
            @if (!string.IsNullOrEmpty(Model.ProductImage))
            {
                <img src="@Url.Content(Model.ProductImage)"
                     style="max-width:100%; max-height:300px; object-fit:contain;" />
            }
            else
            {
                <p>Không có ảnh</p>
            }
        </div>

        <div class="col-md-8">

            <p><strong>Mã sản phẩm:</strong> @Model.ProductID</p>

            <p><strong>Tên sản phẩm:</strong> @Model.ProductName</p>

            <p>
                <strong>Danh mục:</strong>
                @(Model.Category != null
                    ? Model.Category.CategoryName
                    : "Không có")
            </p>

            <p>
                <strong>Giá:</strong>
                @Model.ProductPrice.ToString("N0") VNĐ
            </p>

            <p><strong>Số lượng:</strong> @Model.Quantity</p>

            <p>
                <strong>Mô tả:</strong>
                @Model.ProductDecription
            </p>

            <br />

            @Html.ActionLink(
                     "Quay lại",
                     "Index",
                     null,
                     new { @class = "btn btn-secondary" }
                 )

        </div>

    </div>

</div>