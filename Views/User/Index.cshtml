@model IEnumerable<_25DH110574_Tien_KTRABE.Models.User>

@{
    ViewBag.Title = "Quản lý tài khoản";
}

<div class="container mt-4">

    <h2>QUẢN LÝ TÀI KHOẢN</h2>

    <p>
        @Html.ActionLink(
                 "➕ Thêm tài khoản",
                 "Create",
                 "User",
                 null,
                 new { @class = "btn btn-primary" }
             )
    </p>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <table class="table table-bordered table-striped">

        <thead>
            <tr>
                <th>Tên đăng nhập</th>
                <th>Vai trò</th>
                <th>Thao tác</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Username</td>
                    <td>
                        @(item.UserRole == "A" ? "Admin" : "Customer")
                    </td>

                    <td>
                        @Html.ActionLink(
                                 "Sửa",
                                 "Edit",
                                 new { id = item.Username },
                                 new { @class = "btn btn-warning btn-sm" }
                             )

                        @Html.ActionLink(
                                 "Xóa",
                                 "Delete",
                                 new { id = item.Username },
                                 new
                                 {
                                     @class = "btn btn-danger btn-sm",
                                     onclick = "return confirm('Bạn có chắc muốn xóa tài khoản này không?');"
                                 }
                             )
                    </td>
                </tr>
            }

        </tbody>

    </table>

</div>