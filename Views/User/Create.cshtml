@model _25DH110574_Tien_KTRABE.Models.User

@{
    ViewBag.Title = "Thêm tài khoản";
}

<div class="container mt-4">

    <h2>THÊM TÀI KHOẢN</h2>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="form-group">
            @Html.LabelFor(m => m.Username)
            @Html.TextBoxFor(m => m.Username, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-danger" })
        </div>

        <div class="form-group mt-3">
            @Html.LabelFor(m => m.Password)
            @Html.PasswordFor(m => m.Password, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
        </div>

        <div class="form-group mt-3">
            @Html.LabelFor(m => m.UserRole)
            @Html.DropDownListFor(
                     m => m.UserRole,
                     new SelectList(new[]
                     {
                    new { Value = "A", Text = "Admin" },
                    new { Value = "C", Text = "Customer" }
                         }, "Value", "Text"),
                     "-- Chọn vai trò --",
                     new { @class = "form-control" }
                 )
            @Html.ValidationMessageFor(m => m.UserRole, "", new { @class = "text-danger" })
        </div>

        <br />

        <button type="submit" class="btn btn-primary">Thêm</button>

        @Html.ActionLink(
                 "Quay lại",
                 "Index",
                 null,
                 new { @class = "btn btn-secondary" }
             )
    }

</div>