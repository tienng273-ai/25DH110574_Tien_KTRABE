@model _25DH110574_Tien_KTRABE.Models.Order

@{
    ViewBag.Title = "Chi tiết giao dịch";
}

<div class="container mt-4">

    <h2>CHI TIẾT GIAO DỊCH</h2>

    <div class="card mt-4 p-3">
        <h4>Thông tin khách hàng</h4>

        <p>
            <strong>Mã khách hàng:</strong>
            @Model.CustomerID
        </p>

        <p>
            <strong>Họ tên:</strong>
            @Model.Customer.CustomerName
        </p>

        <p>
            <strong>Số điện thoại:</strong>
            @Model.Customer.CustomerPhone
        </p>

        <p>
            <strong>Email:</strong>
            @Model.Customer.CustomerEmail
        </p>

        <p>
            <strong>Địa chỉ giao hàng:</strong>
            @Model.AddressDelivery
        </p>

        <p>
            <strong>Ngày mua:</strong>
            @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")
        </p>

        <p>
            <strong>Trạng thái:</strong>
            @Model.PaymentStatus
        </p>
    </div>

    <h4 class="mt-4">Danh sách sản phẩm</h4>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Sản phẩm</th>
                <th>Đơn giá</th>
                <th>Số lượng</th>
                <th>Thành tiền</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var detail in Model.OrderDetails)
            {
                decimal subtotal = detail.UnitPrice * detail.Quantity;

                <tr>
                    <td>@detail.Product.ProductName</td>

                    <td>
                        @detail.UnitPrice.ToString("N0") VNĐ
                    </td>

                    <td>
                        @detail.Quantity
                    </td>

                    <td>
                        @subtotal.ToString("N0") VNĐ
                    </td>
                </tr>
            }
        </tbody>

        <tfoot>
            <tr>
                <td colspan="3" class="text-end">
                    <strong>TỔNG TIỀN:</strong>
                </td>

                <td>
                    <strong>
                        @Model.TotalAmount.ToString("N0") VNĐ
                    </strong>
                </td>
            </tr>
        </tfoot>
    </table>

    <a href="@Url.Action("TransactionHistory", "Customer")"
       class="btn btn-secondary">
        Quay lại lịch sử giao dịch
    </a>

</div>