@model _25DH110574_Tien_KTRABE.Models.Customer

@{
    ViewBag.Title = "Chi tiết khách hàng";
}

<div class="container mt-4">

    <h2>CHI TIẾT KHÁCH HÀNG</h2>

    <div class="card mt-4 p-3">

        <h4>Thông tin khách hàng</h4>

        <p><strong>Mã khách hàng:</strong> @Model.CustomerID</p>
        <p><strong>Họ tên:</strong> @Model.CustomerName</p>
        <p><strong>Số điện thoại:</strong> @Model.CustomerPhone</p>
        <p><strong>Email:</strong> @Model.CustomerEmail</p>
        <p><strong>Địa chỉ:</strong> @Model.CustomerAddress</p>

    </div>

    <h4 class="mt-4">Danh sách đơn hàng</h4>

    <table class="table table-bordered table-striped">

        <thead>
            <tr>
                <th>Mã đơn</th>
                <th>Ngày đặt</th>
                <th>Tổng tiền</th>
                <th>Trạng thái</th>
            </tr>
        </thead>

        <tbody>

            @if (Model.Orders != null && Model.Orders.Any())
            {
                foreach (var order in Model.Orders.OrderByDescending(o => o.OrderDate))
                {
                    <tr>
                        <td>@order.OrderID</td>
                        <td>@order.OrderDate.ToString("dd/MM/yyyy")</td>
                        <td>@order.TotalAmount.ToString("N0") VNĐ</td>
                        <td>@order.PaymentStatus</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center">
                        Khách hàng chưa có đơn hàng.
                    </td>
                </tr>
            }

        </tbody>

    </table>

    @Html.ActionLink(
            "Quay lại",
            "Index",
            "Customer",
            null,
            new { @class = "btn btn-secondary" }
        )

</div>